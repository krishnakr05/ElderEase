<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@android:color/white">

    <!-- Top Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Center Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Title -->
        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Caregiver Protection"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:gravity="center" />

        <!-- Space between title and text -->
        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <!-- Description (CONSTRAINED WIDTH) -->
        <TextView
            android:id="@+id/txtDescription"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:text="You can protect settings using a caregiver PIN for added safety.\n\nThis is optional and can be enabled later in Settings."
            android:textSize="18sp"
            android:textColor="#444444"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>

    <!-- Bottom Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Buttons -->
    <Button
        android:id="@+id/btnSetup"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="Set Up Caregiver"
        android:textSize="18sp"
        android:textAllCaps="false"
        android:backgroundTint="#4CAF50"
        android:textColor="@android:color/white"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnSkip"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="Skip"
        android:textSize="18sp"
        android:textAllCaps="false"
        android:backgroundTint="#BDBDBD"
        android:textColor="@android:color/black" />

</LinearLayout>