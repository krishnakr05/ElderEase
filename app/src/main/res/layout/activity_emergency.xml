<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F4F4"
    android:padding="20dp">

    <!-- TOP BAR -->
    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="&lt; Back"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#EEEEEE"
            android:textColor="#333333"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Emergency Support"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginEnd="70dp"/>

    </LinearLayout>

    <!-- GPS BOX -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="25dp"
        android:background="@drawable/gps_bg"
        android:gravity="center"
        android:padding="15dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPS Location is being shared with family"
            android:textStyle="bold"
            android:textSize="16sp"/>
    </LinearLayout>

    <!-- HELP BUTTON -->
    <Button
        android:id="@+id/btnHelp"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="40dp"
        android:background="@drawable/help_circle_bg"
        android:text="HELP"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        android:textStyle="bold"/>

    <!-- CANCEL BUTTON -->
    <Button
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/cancel_bg"
        android:text="CANCEL"
        android:textColor="#000000"
        android:textStyle="bold"
        android:textSize="18sp"/>
    <Button
        android:id="@+id/btnViewContacts"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="20dp"
        android:text="View Emergency Contacts"
        android:textSize="18sp"
        android:backgroundTint="#A8C8CF"/>

</LinearLayout>
